---
interface Props {
  title?: string;
  text?: string;
  phone?: string;
  phoneDisplay?: string;
  secondary?: { label: string; href: string };
  variant?: 'sport' | 'leisure';
}
const {
  title = 'Оставьте заявку — мы перезвоним',
  text = 'Подберём формат, расскажем про свободные даты и поможем с бронированием.',
  phone = 'tel:+79186390397',
  phoneDisplay = '+7 (918) 639-03-97',
  secondary,
  variant = 'sport',
} = Astro.props;
const btnClass = variant === 'sport' ? 'btn--primary' : 'btn--leisure';
---

<div class="cta-banner reveal">
  <div>
    <h2>{title}</h2>
    <p>{text}</p>
  </div>
  <div style="display:flex;flex-wrap:wrap;gap:12px">
    <a class={`btn btn--lg ${btnClass}`} href={phone}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
      {phoneDisplay}
    </a>
    {secondary && <a class="btn btn--lg btn--light" href={secondary.href}>{secondary.label}</a>}
  </div>
</div>
