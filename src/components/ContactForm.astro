---
import { site } from '../config';

const directions = [
  'Прокатный картинг',
  'Трек-дни',
  'Дрифт-соревнования',
  'Аренда боксов',
  'Гостиница',
  'Ресторан',
  'Бани',
  'Бассейн',
  'Беседки',
  'Другое',
];
---

<div class="form-card">
  <form id="lead-form" action="#" method="post">
    <div class="field">
      <label for="f-direction">Что вас интересует</label>
      <select id="f-direction" name="direction">
        {directions.map((d) => <option value={d}>{d}</option>)}
      </select>
    </div>
    <div class="field">
      <label for="f-name">Имя</label>
      <input id="f-name" name="name" type="text" placeholder="Как к вам обращаться" autocomplete="name" />
    </div>
    <div class="field">
      <label for="f-phone">Телефон</label>
      <input id="f-phone" name="phone" type="tel" placeholder="+7 ___ ___-__-__" autocomplete="tel" />
    </div>
    <div class="field">
      <label for="f-msg">Сообщение</label>
      <textarea id="f-msg" name="message" placeholder="Опишите задачу или вопрос"></textarea>
    </div>
    <label style="display:flex;gap:8px;align-items:flex-start;font-size:0.85rem;color:var(--muted);margin-bottom:14px">
      <input type="checkbox" name="agree" required style="margin-top:2px" />
      Я согласен на обработку персональных данных
    </label>
    <button type="submit" class="btn btn--primary btn--lg" style="width:100%">
      Отправить заявку
    </button>
    <p class="form-hint">Заявка откроет письмо на {site.email} — либо позвоните нам напрямую по телефонам ниже.</p>
  </form>
</div>

<script>
  const form = document.getElementById('lead-form') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const subject = 'Заявка с сайта СТК «Пилот» — ' + (fd.get('direction') || '');
    const body =
      'Направление: ' + (fd.get('direction') || '') +
      '\nИмя: ' + (fd.get('name') || '') +
      '\nТелефон: ' + (fd.get('phone') || '') +
      '\nСообщение: ' + (fd.get('message') || '');
    window.location.href = 'mailto:stkpilot@yandex.ru?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body);
  });
</script>
