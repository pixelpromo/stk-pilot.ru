---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABanner from '../components/CTABanner.astro';
import { site, asset } from '../config';
import { trackRental } from '../data/content';
---

<BaseLayout
  title={`Аренда трассы — ${site.name}`}
  description="Аренда трассы СТК «Пилот» в Усть-Лабинске: трасса целиком для прокатного картинга, соревнований, тест-драйвов и корпоративных мероприятий."
>
  <section class="page-hero section section--soft">
    <div class="container">
      <div class="crumbs"><a href="/">Главная</a><span>/</span>Аренда трассы</div>
      <span class="kicker">Спорт на трассе</span>
      <h1>Аренда трассы</h1>
      <p class="lead">{trackRental.lead}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid--2" style="max-width:760px">
        {trackRental.options.map((o) => (
          <div class="card">
            <div class="card__body" style="padding:28px;align-items:center;text-align:center">
              <h3 class="card__title" style="font-size:1.3rem">{o.name}</h3>
              <div style="font-family:var(--font-display);font-weight:700;font-size:2rem;color:var(--accent)">{o.price}</div>
              {o.period && <div class="muted" style="font-size:0.95rem">/ {o.period}</div>}
              {o.note && <p class="card__text" style="text-align:center">{o.note}</p>}
              <a class="btn btn--primary" href={trackRental.phone}>Забронировать трассу</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <div class="split-head">
        <div>
          <h2>Трасса под ваше событие</h2>
          <p class="lead">
            Картодром 1257 м подходит для прокатного картинга, тест-драйвов, соревнований
            и выездных корпоративных мероприятий. Условия и свободные даты — по телефону.
          </p>
        </div>
        <div style="border-radius:var(--radius-lg);overflow:hidden;border:1px solid var(--line)">
          <img src={asset('/images/hero.jpg')} alt="Аренда трассы СТК «Пилот»" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:40px">
    <div class="container">
      <CTABanner
        title="Забронировать трассу"
        text="Аренда трассы, тест-драйв и соревнования — по телефону."
        phone={trackRental.phone}
        phoneDisplay={trackRental.phoneDisplay}
        secondary={{ label: 'Трек-дни и тренировки', href: '/trek-dni/' }}
      />
    </div>
  </section>
</BaseLayout>
