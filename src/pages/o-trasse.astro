---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABanner from '../components/CTABanner.astro';
import { site, asset } from '../config';
import { timeline } from '../data/content';

const highlights = [
  { title: 'Первая гонка в истории РДС', text: '16–17 апреля 2010 года здесь прошёл первый этап РДС-Запад — самая первая гонка Российской Дрифт Серии. За два дня — более 2000 зрителей.' },
  { title: 'Единственная площадка СДЧ', text: 'С сезона 2024/25 трасса — единственная площадка чемпионата Systême Electric Drift Challenge (Сочи Дрифт Челлендж).' },
  { title: 'Мировой рекорд по дрифту', text: 'На Drift Games Pro Am поставлен мировой рекорд — 720 парных заездов за два дня соревнований.' },
  { title: 'Круглый год', text: 'Единственный формат в России, где можно гонять зимой так же, как летом — асфальт готов в любой сезон.' },
];
---

<BaseLayout
  title={`О комплексе — ${site.name}`}
  description="Картодром СТК «Пилот» в Усть-Лабинске: история с 2008 года, характеристики трассы (1257 м), первая гонка РДС и дрифт-чемпионаты Drift Games Pro Am и Сочи Дрифт Челлендж."
>
  <div class="checkered-strip" aria-hidden="true"></div>

  <section class="page-hero section section--soft">
    <div class="container">
      <div class="crumbs"><a href="/">Главная</a><span>/</span>О комплексе</div>
      <span class="kicker">О комплексе</span>
      <h1>СТК Пилот</h1>
      <p class="lead">
        Спортивно-технический комплекс в Усть-Лабинске. Трасса построена как картодром в 2008 году,
        а сегодня принимает и картинг, и трек-дни, и два крупных дрифт-чемпионата — круглый год.
      </p>
    </div>
  </section>

  <!-- Значимые события -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Значимые события</span>
        <h2 class="headline--sport">Чем известна трасса</h2>
      </div>
      <div class="grid grid--2">
        {highlights.map((h) => (
          <div class="card">
            <div class="card__body" style="padding:24px">
              <h3 class="card__title">{h.title}</h3>
              <p class="card__text">{h.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- История -->
  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <span class="kicker">История</span>
        <h2 class="headline--sport">Как развивалась трасса</h2>
      </div>
      <div class="timeline">
        {timeline.map((e) => (
          <div class="tl-item">
            <div class="tl-item__year">{e.year}</div>
            <div class="tl-item__title">{e.title}</div>
            <p class="tl-item__text">{e.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Как добраться -->
  <section class="section section--tint">
    <div class="container">
      <div class="split-head">
        <div>
          <span class="kicker">Как добраться</span>
          <h2>Мы в Усть-Лабинске</h2>
          <p class="lead">{site.address}</p>
          <p class="lead">
            Из Краснодара — по трассе Р-268 через Динскую и Кирпильскую, около 1,5 часов.
            Из Сочи и Ростова-на-Дону — по трассе М4 «Дон» до развязки на Усть-Лабинск.
          </p>
          <a class="btn btn--primary" href={site.yandexMaps} rel="noopener" target="_blank">Построить маршрут</a>
        </div>
        <div style="border-radius:var(--radius-lg);overflow:hidden;border:1px solid var(--line)">
          <img src={asset('/images/trek-dni.jpg')} alt="Трасса СТК «Пилот»" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:40px">
    <div class="container">
      <CTABanner
        title="Хотите покататься или арендовать трассу?"
        text="Позвоните — подскажем свободные сессии и поможем с бронью."
        phone="tel:+78613542003"
        phoneDisplay="+7 (861) 354-20-03"
        secondary={{ label: 'Трек-дни и цены', href: '/trek-dni/' }}
      />
    </div>
  </section>
</BaseLayout>
