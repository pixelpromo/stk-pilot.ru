---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABanner from '../components/CTABanner.astro';
import { site, asset } from '../config';
import { gazebos } from '../data/content';
---

<BaseLayout
  title={`Беседки — ${site.name}`}
  description="Аренда беседок на территории СТК «Пилот» в Усть-Лабинске: уютные беседки у зарыбленного пруда для любых мероприятий."
>
  <section class="page-hero section section--soft">
    <div class="container">
      <div class="crumbs"><a href="/">Главная</a><span>/</span>Беседки</div>
      <span class="kicker">Отдых и сервис</span>
      <h1>Беседки</h1>
      <p class="lead">{gazebos.lead}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="split-head">
        <div>
          <h2>Праздник у пруда</h2>
          <p class="lead">Беседки подходят для дней рождения, корпоративов и семейных встреч. Количество гостей — любое.</p>
          <p class="lead">Актуальный прайс уточняйте по телефону.</p>
          <a class="btn btn--leisure" href={gazebos.phone}>Забронировать беседку</a>
        </div>
        <div style="border-radius:var(--radius-lg);overflow:hidden;border:1px solid var(--line)">
          <img src={asset('/images/besedki.jpg')} alt="Беседки СТК «Пилот»" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:40px">
    <div class="container">
      <CTABanner
        title="Забронировать беседку"
        text="Ресторан и беседки — по телефону."
        phone={gazebos.phone}
        phoneDisplay={gazebos.phoneDisplay}
        variant="leisure"
      />
    </div>
  </section>
</BaseLayout>
