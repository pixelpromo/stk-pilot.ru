---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABanner from '../components/CTABanner.astro';
import { site, asset } from '../config';
import { boxes } from '../data/content';
---

<BaseLayout
  title={`Аренда боксов — ${site.name}`}
  description="Аренда боксов для хранения техники на трассе СТК «Пилот» в Усть-Лабинске: маленький и большой бокс."
>
  <section class="page-hero section section--soft">
    <div class="container">
      <div class="crumbs"><a href="/">Главная</a><span>/</span>Боксы</div>
      <span class="kicker">Спорт на трассе</span>
      <h1>Аренда боксов</h1>
      <p class="lead">{boxes.lead}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid--2" style="max-width:760px">
        {boxes.cards.map((c) => (
          <div class="card">
            <div class="card__body" style="padding:28px;align-items:center;text-align:center">
              <h3 class="card__title" style="font-size:1.3rem">{c.name}</h3>
              <div style="font-family:var(--font-display);font-weight:700;font-size:2.2rem;color:var(--accent)">{c.price}</div>
              <div class="muted" style="font-size:0.95rem">{c.period}</div>
              <a class="btn btn--primary" href={boxes.phone} style="margin-top:12px">Забронировать бокс</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <div class="split-head">
        <div>
          <h2>Храните технику рядом с трассой</h2>
          <p class="lead">Боксы подходят для картов, мотоциклов и автомобилей — готовьте машину к заезду без перевозки.</p>
        </div>
        <div style="border-radius:var(--radius-lg);overflow:hidden;border:1px solid var(--line)">
          <img src={asset('/images/boksy.jpg')} alt="Боксы СТК «Пилот»" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:40px">
    <div class="container">
      <CTABanner
        title="Забронировать бокс"
        text="Уточните наличие и условия аренды."
        phone={boxes.phone}
        phoneDisplay={boxes.phoneDisplay}
      />
    </div>
  </section>
</BaseLayout>
